# Supabase — get these from your project Settings → API → Legacy keys tab
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Dashboard auth — single shared password + a random secret for signing cookies
# DASHBOARD_SECRET can be any long random string (e.g. openssl rand -base64 32)
DASHBOARD_PASSWORD=choose-a-strong-password
DASHBOARD_SECRET=a-long-random-string-used-to-sign-session-cookies

# API key that Roblox game servers send via x-api-key header
ROBLOX_API_SECRET=your-roblox-secret
# During a rotation, temporarily set this to the old key. Remove it after all
# Roblox servers are confirmed to use ROBLOX_API_SECRET.
ROBLOX_API_SECRET_PREVIOUS=

# Separate read-only key for your Discord bot (GET routes only)
DISCORD_BOT_API_KEY=your-discord-bot-key
